        lidar_left_link:
          Value: true
        lidar_right_link:
          Value: true
        map:
          Value: true
        odom:
          Value: true
      Marker Scale: 0.25
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          odom:
            base_link:
              lidar_left_link:
                {}
              lidar_right_link:
                {}
      Update Interval: 0
      Value: true
    - Alpha: 1
